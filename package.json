{
  "name": "byakugan",
  "version": "0.8.0-beta.131",
  "description": "BYAKUGAN — a VALORANT performance, post-game analysis, and streaming companion.",
  "main": "src/main/index.cjs",
  "author": "Tyler Ganza (Spartan)",
  "license": "UNLICENSED",
  "private": true,
  "updateFeedConfigured": true,
  "updateRepository": {
    "provider": "github",
    "owner": "SpartyTG",
    "repo": "Byakugan",
    "channel": "beta"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SpartyTG/Byakugan.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/*.test.cjs",
    "test:brain": "node scripts/run-sensei-brain-smokes.cjs",
    "check": "node scripts/check-source.cjs",
    "verify": "npm run check && npm test && npm run test:brain",
    "dist:win": "node scripts/prepare-release.cjs && electron-builder --win nsis --x64 --config release-config.json --publish never && node scripts/verify-release.cjs",
    "release:win": "node scripts/prepare-release.cjs --require-feed && electron-builder --win nsis --x64 --config release-config.json --publish never && node scripts/verify-release.cjs --require-feed",
    "dist:dir": "node scripts/prepare-release.cjs && electron-builder --dir --config release-config.json"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "com.tyler.byakugan",
    "productName": "BYAKUGAN",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "verifyUpdateCodeSignature": false,
      "artifactName": "BYAKUGAN-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
